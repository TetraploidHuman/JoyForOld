# 复制本文件为 local.properties 后填入自己的密钥（local.properties 已在 .gitignore 中，不会提交）
#
# cp local.properties.example local.properties   # macOS / Linux
# copy local.properties.example local.properties # Windows

# DeepSeek（AI 操控）
deepseek.api.key=
deepseek.model=deepseek-v4-flash

# 火山方舟 LLM（Responses API，推荐用于截图 Agent）
# 1. 控制台 → 火山方舟 → 开通模型 doubao-seed-2.0-mini（或创建推理接入点）
# 2. llm.model 填「推理接入点 ID」（ep-xxxx）或已开通的模型名（如 doubao-seed-2-0-mini-260428）
# 3. 账户需充值后调用（余额为 0 会失败）
llm.api.key=
llm.model=doubao-seed-2-0-mini-260428
llm.base_url=https://ark.cn-beijing.volces.com/api/v3/responses

# 智谱（旧配置，仍可作为 llm.api.key 的回退）
zhipu.api.key=
zhipu.model=glm-4.6v-flash

# 豆包 / 火山引擎 语音识别（二选一鉴权方式）
#
# 新版：只填 api_key
volc.asr.api_key=

# 旧版：填 app_id + access_token（此时 api_key 留空）
volc.asr.app_id=
volc.asr.access_token=

# 资源 ID，按火山控制台开通的模型填写，例如：
# volc.bigasr.sauc.duration  或  volc.seedasr.sauc.duration
volc.asr.resource_id=volc.bigasr.sauc.duration

# 家人远程协助后端（Ktor + H2）
# 模拟器访问本机：10.0.2.2；真机请改成电脑局域网 IP
assist.server.url=http://10.0.2.2:8787
assist.server.ws=ws://10.0.2.2:8787/ws

# sdk.dir 无需填写：构建时会按以下顺序自动检测 Android SDK
# 1. local.properties 里的 sdk.dir（若已填写）
# 2. 环境变量 ANDROID_SDK_ROOT / ANDROID_HOME
# 3. 系统默认路径（Windows / macOS / Linux 常见安装位置）
